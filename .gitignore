# dependencies (bun install)
node_modules

# Bun is the package manager and bun.lock is the lockfile. A second lockfile
# from another manager can resolve different versions than the one CI installs
# from, so the build stops matching what anyone tested.
package-lock.json
yarn.lock
pnpm-lock.yaml

# output
out
dist/
*.tgz

# Codemon session data (auto-created at runtime)
.codemon/


# code coverage
coverage
*.lcov

# logs
logs
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# Editors
.idea
.vscode

# Finder (MacOS) folder config
.DS_Store
